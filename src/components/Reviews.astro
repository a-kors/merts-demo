---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { master } from '../data/master';
import videoPoster from '../assets/photos/manifesto.jpg';

const imgs = import.meta.glob<{ default: ImageMetadata }>('/src/assets/reviews/*.jpg', { eager: true });
const reviewItems = Object.entries(imgs)
  .sort(([a], [b]) => {
    const ai = parseInt(a.match(/review-(\d+)/)?.[1] || '0', 10);
    const bi = parseInt(b.match(/review-(\d+)/)?.[1] || '0', 10);
    return ai - bi;
  })
  .map(([path, mod], i) => ({
    img: mod.default,
    key: path,
    idx: i,
  }));
---

<section id="reviews" class="rv">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <span class="section-eyebrow">Отзывы</span>
      <h2>То, что мне пишут в личку — без монтажа.</h2>
      <p>
        Скриншоты из альбома в&nbsp;сообществе — переписки с&nbsp;клиентами,
        которые согласились на&nbsp;публикацию. Видеоотзыв — там&nbsp;же.
      </p>
    </header>

    <div class="rv__wall" data-wall>
      <div class="rv__cols">
        <a
          class="rc rc--video"
          href={master.reviewVideoUrl}
          target="_blank"
          rel="noopener"
          data-reveal
        >
          <div class="rc__poster">
            <Image
              src={videoPoster}
              alt=""
              widths={[400, 600, 800]}
              sizes="(max-width: 600px) 90vw, 360px"
              format="webp"
              quality={82}
              loading="lazy"
              class="rc__poster-img"
            />
            <span class="rc__shade" aria-hidden="true"></span>
            <span class="rc__play" aria-hidden="true">▶</span>
            <span class="rc__dur">2:12</span>
          </div>
          <div class="rc__body">
            <span class="rc__kind">Видеоотзыв</span>
            <h3>«Почувствовал себя хозяином своей жизни!»</h3>
            <p class="muted">Смотреть в&nbsp;ВКонтакте →</p>
          </div>
        </a>

        {reviewItems.map((it, i) => (
          <a
            class="rc rc--photo"
            href={master.vkReviewsAlbum}
            target="_blank"
            rel="noopener"
            data-reveal
            data-reveal-delay={Math.min(i * 60, 300)}
            aria-label={`Отзыв ${it.idx + 1}`}
          >
            <Image
              src={it.img}
              alt={`Отзыв клиента, скриншот ${it.idx + 1}`}
              widths={[300, 500]}
              sizes="(max-width: 600px) 90vw, 300px"
              format="webp"
              loading="lazy"
            />
          </a>
        ))}
      </div>
      <div class="rv__fade" aria-hidden="true"></div>
    </div>

    <div class="rv__footer">
      <button class="btn btn-secondary" type="button" data-more>
        <span>Показать все отзывы</span>
        <span class="arrow" aria-hidden="true">↓</span>
      </button>
      <a class="btn btn-ghost" href={master.vkReviewsAlbum} target="_blank" rel="noopener">
        Открыть альбом в&nbsp;ВКонтакте →
      </a>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-wall]').forEach((wall) => {
    const section = wall.closest('section');
    const btn = section?.querySelector<HTMLButtonElement>('[data-more]');
    btn?.addEventListener('click', () => {
      wall.classList.add('is-open');
      btn.hidden = true;
    });
  });
</script>

<style>
  .rv {
    background: var(--bg-soft);
  }
  .rv__wall {
    position: relative;
    max-height: 1800px;
    overflow: hidden;
    transition: max-height 0.6s ease;
    margin-bottom: 32px;
  }
  .rv__wall.is-open {
    max-height: none;
  }
  .rv__wall.is-open .rv__fade {
    display: none;
  }
  .rv__fade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 220px;
    background: linear-gradient(to bottom, rgba(243, 237, 225, 0), var(--bg-soft) 92%);
    pointer-events: none;
  }
  .rv__cols {
    columns: 3;
    column-gap: 16px;
  }
  .rc {
    display: block;
    break-inside: avoid;
    margin: 0 0 16px;
    border-radius: 14px;
    overflow: hidden;
    background: #ffffff;
    box-shadow:
      0 1px 2px rgba(31, 25, 21, 0.05),
      0 6px 20px rgba(31, 25, 21, 0.06);
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .rc:hover {
    transform: translateY(-2px);
    box-shadow:
      0 2px 4px rgba(31, 25, 21, 0.08),
      0 18px 32px rgba(31, 25, 21, 0.1);
  }
  .rc--photo :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }
  .rc__poster {
    aspect-ratio: 3 / 4;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--ink);
  }
  .rc__poster-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  .rc__shade {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 50% 42%, rgba(0,0,0,0.0) 0%, rgba(0,0,0,0.35) 70%),
      linear-gradient(180deg, rgba(31,25,21,0.15) 0%, rgba(31,25,21,0.55) 100%);
  }
  .rc__play {
    position: relative;
    z-index: 1;
    width: 62px;
    height: 62px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.96);
    color: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 17px;
    padding-left: 4px;
    box-shadow: 0 16px 32px -8px rgba(0, 0, 0, 0.45);
  }
  .rc__dur {
    z-index: 1;
  }
  .rc__dur {
    position: absolute;
    bottom: 10px;
    right: 10px;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.9);
    background: rgba(0, 0, 0, 0.35);
    padding: 3px 8px;
    border-radius: 999px;
    letter-spacing: 0.04em;
  }
  .rc__body {
    padding: 18px 20px 20px;
  }
  .rc__kind {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .rc__body h3 {
    font-family: var(--font-serif);
    font-size: 20px;
    line-height: 1.22;
    margin: 8px 0 8px;
    font-weight: 400;
    letter-spacing: -0.015em;
    color: var(--ink);
  }
  .muted {
    color: var(--ink-muted);
  }

  .rv__footer {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 14px 28px;
    margin-top: 12px;
  }

  @media (max-width: 960px) {
    .rv__wall {
      max-height: 1600px;
    }
    .rv__cols {
      columns: 2;
    }
  }
  @media (max-width: 520px) {
    .rv__wall {
      max-height: 1800px;
    }
    .rv__cols {
      columns: 1;
    }
  }
</style>
