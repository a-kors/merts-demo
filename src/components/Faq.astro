---
import { faq } from '../data/master';
---

<section id="faq" class="soft-bg">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <span class="section-eyebrow">Частые вопросы</span>
      <h2>Коротко и&nbsp;без воды.</h2>
    </header>

    <div class="list" data-reveal data-reveal-delay="100">
      {faq.map((item, i) => (
        <details open={i === 0}>
          <summary>
            <span class="q">{item.q}</span>
            <span class="plus" aria-hidden="true"></span>
          </summary>
          <div class="a"><p>{item.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .list {
    border-top: 1px solid var(--line-strong);
  }
  details {
    border-bottom: 1px solid var(--line-strong);
  }
  summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 24px 0;
    cursor: pointer;
    font-family: var(--font-serif);
    font-size: clamp(19px, 2vw, 24px);
    letter-spacing: -0.015em;
    line-height: 1.3;
    color: var(--ink);
    transition: color 0.18s ease;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    color: var(--accent);
  }
  .plus {
    position: relative;
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }
  .plus::before,
  .plus::after {
    content: '';
    position: absolute;
    background: var(--ink);
    transition: transform 0.18s ease, background 0.18s ease;
  }
  .plus::before {
    left: 0;
    right: 0;
    top: 50%;
    height: 1.5px;
    transform: translateY(-50%);
  }
  .plus::after {
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1.5px;
    transform: translateX(-50%);
  }
  details[open] .plus::after {
    transform: translateX(-50%) scaleY(0);
  }
  .a {
    padding: 0 48px 24px 0;
    color: var(--ink-muted);
    font-size: 16.5px;
    line-height: 1.65;
    max-width: 780px;
  }
</style>
