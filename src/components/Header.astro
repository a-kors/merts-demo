---
import { Image } from 'astro:assets';
import avatarImg from '../assets/photos/avatar.jpg';
import { master } from '../data/master';

const nav = [
  { href: '#issues', label: 'С чем работаю' },
  { href: '#services', label: 'Форматы и цены' },
  { href: '#how', label: 'Как работаем' },
  { href: '#reviews', label: 'Отзывы' },
  { href: '#faq', label: 'Вопросы' },
];
---

<header class="hdr">
  <div class="wrap row">
    <a href="/" class="brand" aria-label="На главную">
      <span class="mark" aria-hidden="true">
        <Image
          src={avatarImg}
          alt=""
          width={76}
          height={76}
          format="webp"
          quality={92}
          loading="eager"
        />
      </span>
      <span class="brand-name">Эдуард Мерц</span>
    </a>

    <nav class="nav" aria-label="Разделы">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="right">
      <a class="social" href={master.telegram} aria-label="Telegram" title="Telegram">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="m22 2-7 20-4-9-9-4 20-7Z M22 2 11 13" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <a class="social" href={master.vk} aria-label="ВКонтакте" title="ВКонтакте">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M3.5 7h3c0.5 3 1.7 5.7 3.5 7v-7h3v3c0 0.9 0.5 1.3 1 1.3 0.5 0 1-0.4 1.3-1C15.7 9 16.5 7.6 17 7h3c-0.6 2-2.2 4.4-3.3 5.5-0.3 0.3-0.3 0.5 0 0.9 0.5 0.5 2.5 2.9 3 4.1 0.2 0.5-0.1 0.8-0.6 0.8H16c-0.5 0-0.9-0.2-1.3-0.6-0.9-0.9-1.7-2.2-2.5-2.2-0.3 0-0.5 0.2-0.5 0.8V17c0 0.6-0.3 1-1.5 1-3 0-6-2-8.1-6.3C1 10 1 7.5 3.5 7Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
        </svg>
      </a>
      <a class="btn btn-primary cta" href={master.max}>
        <span>Написать в&nbsp;Max</span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
      <button class="burger" aria-label="Открыть меню" aria-expanded="false" type="button" data-burger>
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" data-mobile-menu aria-hidden="true">
  <nav>
    {nav.map((item) => <a href={item.href} data-close>{item.label}</a>)}
  </nav>
  <div class="mobile-actions">
    <a class="btn btn-primary" href={master.max}>
      <span>Написать в&nbsp;Max</span>
      <span class="arrow" aria-hidden="true">→</span>
    </a>
    <div class="mobile-socials">
      <a href={master.telegram}>Telegram</a>
      <a href={master.vk}>ВКонтакте</a>
      <a href={master.whatsapp}>WhatsApp</a>
    </div>
  </div>
</div>

<script>
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const root = document.documentElement;
  const toggle = (open?: boolean) => {
    if (!burger || !menu) return;
    const willOpen = open ?? !menu.classList.contains('is-open');
    menu.classList.toggle('is-open', willOpen);
    burger.classList.toggle('is-open', willOpen);
    burger.setAttribute('aria-expanded', String(willOpen));
    menu.setAttribute('aria-hidden', String(!willOpen));
    root.classList.toggle('no-scroll', willOpen);
  };
  burger?.addEventListener('click', () => toggle());
  menu?.querySelectorAll<HTMLAnchorElement>('[data-close]').forEach((a) =>
    a.addEventListener('click', () => toggle(false))
  );
</script>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(251, 248, 243, 0.92);
    backdrop-filter: saturate(140%) blur(10px);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .hdr .wrap {
    padding-left: clamp(24px, 5vw, 56px);
    padding-right: clamp(24px, 5vw, 56px);
  }
  .row {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 12px 0;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--ink);
  }
  .mark {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    overflow: hidden;
    display: inline-flex;
    flex-shrink: 0;
    background: var(--bg-soft);
  }
  .mark :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .brand-name {
    font-weight: 500;
    font-size: 15.5px;
    letter-spacing: -0.005em;
    white-space: nowrap;
  }

  .nav {
    display: flex;
    gap: 22px;
    margin-left: auto;
  }
  .nav a {
    font-size: 14px;
    color: var(--ink-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .nav a:hover {
    color: var(--accent);
  }

  .right {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: 16px;
  }
  .social {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--ink);
    border: 1px solid var(--line-strong);
    transition: color 0.18s, border-color 0.18s;
    text-decoration: none;
  }
  .social:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .cta {
    padding: 10px 20px;
    font-size: 14px;
  }

  .burger {
    display: none;
    width: 42px;
    height: 42px;
    border: 1px solid var(--line-strong);
    background: #ffffff;
    border-radius: 50%;
    padding: 0;
    cursor: pointer;
    position: relative;
  }
  .burger span {
    position: absolute;
    left: 12px;
    right: 12px;
    height: 1.6px;
    background: var(--ink);
    border-radius: 2px;
    transition: transform 0.2s, opacity 0.2s, top 0.2s;
  }
  .burger span:nth-child(1) { top: 15px; }
  .burger span:nth-child(2) { top: 20px; }
  .burger span:nth-child(3) { top: 25px; }
  .burger.is-open span:nth-child(1) { top: 20px; transform: rotate(45deg); }
  .burger.is-open span:nth-child(2) { opacity: 0; }
  .burger.is-open span:nth-child(3) { top: 20px; transform: rotate(-45deg); }

  .mobile-menu {
    position: fixed;
    top: 62px;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--bg);
    padding: 32px clamp(24px, 5vw, 56px) 40px;
    display: none;
    flex-direction: column;
    gap: 32px;
    z-index: 100;
    overflow-y: auto;
  }
  .mobile-menu.is-open {
    display: flex;
  }
  .mobile-menu nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .mobile-menu nav a {
    display: block;
    font-family: var(--font-serif);
    font-size: 26px;
    color: var(--ink);
    text-decoration: none;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    letter-spacing: -0.015em;
  }
  .mobile-actions {
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: flex-start;
  }
  .mobile-actions .btn {
    align-self: stretch;
    justify-content: center;
  }
  .mobile-socials {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 14px;
  }
  .mobile-socials a {
    color: var(--ink-muted);
    text-decoration: none;
  }

  @media (max-width: 1120px) {
    .nav { display: none; }
    .right .social,
    .right .cta { display: none; }
    .burger { display: block; }
  }

  :global(html.no-scroll),
  :global(html.no-scroll body) {
    overflow: hidden;
  }
</style>
