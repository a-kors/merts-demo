---
import { Image } from 'astro:assets';
import manifestoImg from '../assets/photos/manifesto.jpg';
---

<section class="man" aria-labelledby="manifesto-h">
  <div class="wrap grid">
    <figure class="photo" data-reveal>
      <Image
        src={manifestoImg}
        alt="Эдуард Мерц, формальный портрет"
        widths={[520, 780, 1040]}
        sizes="(max-width: 860px) 320px, 480px"
        format="webp"
        quality={88}
        loading="lazy"
        class="photo-img"
      />
    </figure>

    <div class="copy" data-reveal data-reveal-delay="120">
      <span class="eyebrow">Что я делаю</span>

      <h2 id="manifesto-h">
        Возвращаю людям ощущение,
        <br />что <em>они&nbsp;— хозяева</em>
        <br />своей жизни.
      </h2>

      <p class="lead">
        Не&nbsp;бесконечной терапией. Короткими встречами, после которых
        понятно, что делать завтра утром, — и&nbsp;как не&nbsp;вернуться туда,
        откуда начали.
      </p>

      <p class="meta">
        <span class="tag">краткосрочно</span>
        <span class="tag">системно</span>
        <span class="tag">без диагнозов</span>
      </p>
    </div>
  </div>
</section>

<style>
  .man {
    padding: clamp(80px, 11vw, 160px) 0;
    background: #ffffff;
    overflow: hidden;
  }
  .grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }
  .grid > * {
    min-width: 0;
  }

  /* фото — полноразмерный портрет */
  .photo {
    margin: 0;
    position: relative;
  }
  .photo-img {
    width: 100%;
    max-width: 520px;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    display: block;
    border-radius: 2px;
  }
  /* правая колонка */
  .eyebrow {
    display: inline-block;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 36px;
    font-weight: 500;
  }
  h2 {
    font-family: var(--font-serif);
    font-size: clamp(34px, 3.8vw, 58px);
    line-height: 1.04;
    letter-spacing: -0.025em;
    font-weight: 400;
    color: var(--ink);
    margin-bottom: 40px;
  }
  h2 em {
    font-style: italic;
    color: var(--accent);
  }
  .lead {
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink-muted);
    max-width: 480px;
    margin-bottom: 36px;
  }
  .meta {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .tag {
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
    padding: 7px 14px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .photo {
      max-width: 320px;
    }
  }
</style>
