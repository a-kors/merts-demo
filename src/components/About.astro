---
import { Image } from 'astro:assets';
import aboutImg from '../assets/photos/about.jpg';
import { master, bioFacts } from '../data/master';
---

<section id="about">
  <div class="wrap grid">
    <figure class="photo" data-reveal>
      <Image
        src={aboutImg}
        alt="Эдуард Мерц в кабинете"
        widths={[480, 720, 960]}
        sizes="(max-width: 860px) 280px, 420px"
        format="webp"
        quality={88}
        loading="lazy"
        class="photo-img"
      />
    </figure>

    <div class="copy" data-reveal data-reveal-delay="140">
      <span class="section-eyebrow">Обо мне</span>
      <h2>
        Психолог, который <em>помогает</em> вернуть опору —
        и&nbsp;не&nbsp;растягивает это на&nbsp;годы.
      </h2>

      <p class="lead">
        Практикую с&nbsp;2001&nbsp;года. Закончил факультет психологии МПСИ,
        работал психологом и&nbsp;преподавателем в&nbsp;Алтайском институте
        повышения квалификации, вёл частные консультации, тренинги
        и&nbsp;семинары. Сегодня — только частный приём.
      </p>

      <p>
        Мой подход — <strong>краткосрочный и&nbsp;системный</strong>. Я&nbsp;не
        пытаюсь объяснить вам, что «не&nbsp;так» с&nbsp;вашим детством.
        Я&nbsp;ищу вместе с&nbsp;вами, что&nbsp;именно вы можете сделать уже
        завтра утром, — и&nbsp;помогаю это сделать.
      </p>

      <dl class="facts">
        {bioFacts.map((f) => (
          <div>
            <dt>{f.value}</dt>
            <dd>{f.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }
  .photo {
    margin: 0;
  }
  .photo-img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-lg);
    display: block;
  }
  h2 {
    margin-bottom: 28px;
  }
  h2 em {
    font-style: italic;
    color: var(--accent);
  }
  .lead {
    font-size: 18px;
    color: var(--ink);
    margin-bottom: 18px;
    line-height: 1.6;
  }
  .copy p {
    color: var(--ink-muted);
    margin-bottom: 18px;
    font-size: 17px;
    line-height: 1.65;
  }
  .copy p strong {
    color: var(--ink);
    font-weight: 500;
  }


  .facts {
    margin: 36px 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .facts div {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .facts dt {
    font-family: var(--font-serif);
    font-size: 26px;
    color: var(--ink);
    letter-spacing: -0.01em;
    line-height: 1.05;
  }
  .facts dd {
    margin: 0;
    font-size: 13px;
    color: var(--ink-muted);
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .photo {
      max-width: 280px;
    }
    .facts {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
