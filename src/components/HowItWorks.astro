---
import { steps, master } from '../data/master';
import CtaGroup from './CtaGroup.astro';
---

<section id="how">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <span class="section-eyebrow">Как мы будем работать</span>
      <h2>От сообщения до изменений — три шага.</h2>
      <p>
        Я работаю краткосрочно и системно. Это значит: не&nbsp;растягиваю работу
        на&nbsp;годы, а&nbsp;ищу вместе с&nbsp;вами изменение, которое можно
        унести из&nbsp;кабинета уже сегодня.
      </p>
    </header>

    <ol class="steps">
      {steps.map((s, i) => (
        <li data-reveal data-reveal-delay={i * 120}>
          <span class="n">{s.n}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>

    <div class="cta-strip">
      <p>
        Записаться — в&nbsp;любое удобное время.
        <span class="muted"> Ответ в&nbsp;течение дня.</span>
      </p>
      <CtaGroup label="Написать в Max" variant="secondary" />

    </div>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    padding: 0;
    margin: 0 0 56px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .steps li {
    padding: 36px 32px 36px 0;
    position: relative;
  }
  .steps li + li {
    padding-left: 32px;
    border-left: 1px solid var(--line);
  }
  .n {
    font-family: var(--font-serif);
    font-size: 14px;
    letter-spacing: 0.1em;
    color: var(--accent);
    display: block;
    margin-bottom: 16px;
  }
  .steps h3 {
    margin-bottom: 10px;
    font-size: 22px;
    font-weight: 500;
  }
  .steps p {
    color: var(--ink-muted);
    line-height: 1.6;
  }

  .cta-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 24px 0 0;
  }
  .cta-strip p {
    font-size: 17px;
  }

  @media (max-width: 860px) {
    .steps {
      grid-template-columns: 1fr;
    }
    .steps li + li {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .cta-strip {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
