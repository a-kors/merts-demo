---
import { master, site } from '../data/master';

const sw = "1.6";
---

<footer>
  <div class="wrap">
    <div class="top">
      <div class="col">
        <span class="section-eyebrow">Эдуард Мерц</span>
        <p class="muted">
          Психолог · Барнаул · Практикую с&nbsp;{master.practiceSince}&nbsp;года.
        </p>
      </div>

      <div class="col">
        <span class="label">Контакты</span>

        <a class="line" href={master.phoneHref}>
          <svg class="ico" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2A19.86 19.86 0 0 1 2.09 4.18 2 2 0 0 1 4.08 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92Z" stroke="currentColor" stroke-width={sw} stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>{master.phone}</span>
        </a>

        <a class="line" href={master.max}>
          <svg class="ico" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z" stroke="currentColor" stroke-width={sw} stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>Max</span>
        </a>

        <a class="line" href={master.telegram}>
          <svg class="ico" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="m22 2-7 20-4-9-9-4 20-7Z" stroke="currentColor" stroke-width={sw} stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M22 2 11 13" stroke="currentColor" stroke-width={sw} stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>Telegram</span>
        </a>

        <a class="line" href={master.whatsapp}>
          <svg class="ico" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z" stroke="currentColor" stroke-width={sw} stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>WhatsApp</span>
        </a>

        <a class="line" href={master.vk}>
          <svg class="ico" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M3.5 7h3c0.5 3 1.7 5.7 3.5 7v-7h3v3c0 0.9 0.5 1.3 1 1.3 0.5 0 1-0.4 1.3-1C15.7 9 16.5 7.6 17 7h3c-0.6 2-2.2 4.4-3.3 5.5-0.3 0.3-0.3 0.5 0 0.9 0.5 0.5 2.5 2.9 3 4.1 0.2 0.5-0.1 0.8-0.6 0.8H16c-0.5 0-0.9-0.2-1.3-0.6-0.9-0.9-1.7-2.2-2.5-2.2-0.3 0-0.5 0.2-0.5 0.8V17c0 0.6-0.3 1-1.5 1-3 0-6-2-8.1-6.3C1 10 1 7.5 3.5 7Z" stroke="currentColor" stroke-width={sw} stroke-linejoin="round"/>
          </svg>
          <span>ВКонтакте</span>
        </a>

        <a class="line" href={master.vkGroup}>
          <svg class="ico" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" stroke="currentColor" stroke-width={sw} stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="8.5" cy="7" r="4" stroke="currentColor" stroke-width={sw}/>
          </svg>
          <span>Группа «Психология изменений»</span>
        </a>
      </div>

      <div class="col">
        <span class="label">Приём</span>

        <span class="line">
          <svg class="ico" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0Z" stroke="currentColor" stroke-width={sw} stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width={sw}/>
          </svg>
          <span>{master.address}</span>
        </span>

        <span class="line">
          <svg class="ico" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width={sw}/>
            <path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20" stroke="currentColor" stroke-width={sw} stroke-linecap="round"/>
          </svg>
          <span>онлайн по&nbsp;видеосвязи</span>
        </span>
      </div>
    </div>

    <hr class="hair-line" />

    <div class="bottom">
      <p class="muted small">
        © {new Date().getFullYear()} Эдуард Мерц. Материалы страницы —
        собственные заметки автора и&nbsp;цитаты из&nbsp;сообщества «Психология
        изменений».
      </p>
      <p class="muted small">{site.demoBanner}</p>
    </div>
  </div>
</footer>

<style>
  footer {
    background: var(--bg);
    padding: 72px 0 32px;
    border-top: 1px solid var(--line);
  }
  .top {
    display: grid;
    grid-template-columns: 1.3fr 1.2fr 1fr;
    gap: 48px;
    padding-bottom: 48px;
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .col .section-eyebrow {
    margin-bottom: 8px;
  }
  .label {
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 8px;
  }
  .line,
  footer a.line,
  footer a.line:link,
  footer a.line:visited {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    color: var(--ink);
    text-decoration: none;
    transition: color 0.18s ease;
  }
  footer a.line:hover,
  footer a.line:focus-visible {
    color: var(--accent);
  }
  footer a.line:hover .ico {
    color: var(--accent);
  }
  .ico {
    flex-shrink: 0;
    color: var(--ink-soft);
    transition: color 0.18s ease;
  }
  .line.muted,
  footer .line.muted {
    color: var(--ink-muted);
  }
  .line.muted .ico {
    color: var(--ink-soft);
  }
  .bottom {
    padding-top: 28px;
    display: flex;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .small {
    font-size: 13px;
  }
  @media (max-width: 860px) {
    .top {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
