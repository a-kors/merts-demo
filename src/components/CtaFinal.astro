---
import { master } from '../data/master';
import CtaGroup from './CtaGroup.astro';
---

<!--
  Финал: на светлом фоне крупная фраза и кнопка прилипают по центру, снизу поднимается мягкая тёплая сфера
  и заливает экран; текст и кнопка перекрашиваются под тёмный фон; дальше футер на том же цвете.
  Всё привязано к прокрутке (src/scripts/motion.ts), при «уменьшить движение» сразу конечное состояние.
-->
<section class="sun-ft" aria-labelledby="final-h">
  <div class="sun-scene">
    <div class="sun-stick">
      <div class="sun-ball" aria-hidden="true"></div>
      <div class="sun-copy wrap">
        <span class="sun-eyebrow">Хочу перезагрузиться</span>
        <h2 id="final-h" class="fs-h" data-words>Если дочитали досюда,<br />просто напишите.</h2>
        <p class="sun-sub">Отвечу, смогу&nbsp;ли вам помочь.</p>
        <div class="sun-actions">
          <CtaGroup label="Написать в Max" variant="primary" />
          <a class="sun-phone" href={master.phoneHref}>или позвонить: {master.phone}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .sun-ft {
    /* цвет сферы и футера: тёмный тёплый; второй акцент для текста на тёмном */
    --sun: var(--bg-dark);
    --glow: #f2a77e;
    padding: 0;
    background: var(--sun);
    color: #ffffff;
  }

  /* высокая сцена: экран прилипшей сцены + полтора экрана прокрутки на анимацию */
  .sun-scene {
    position: relative;
    height: 250vh;
    background: var(--bg);
  }
  .sun-stick {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    display: grid;
    place-items: center;
    /* в самом конце фон сцены становится цветом сферы: шва с футером нет */
    background: color-mix(in srgb, var(--sun) calc(var(--fill, 0) * 100%), var(--bg));
  }

  /* сфера: огромный круг с мягким радиальным градиентом без края, от тёмного через терракоту в прозрачный */
  .sun-ball {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 200vmax;
    height: 200vmax;
    margin: -100vmax 0 0 -100vmax;
    border-radius: 50%;
    pointer-events: none;
    background: radial-gradient(
      closest-side,
      rgba(34, 26, 19, 1) 0%,
      rgba(34, 26, 19, 1) 22%,
      rgba(42, 29, 20, 0.97) 32%,
      rgba(62, 37, 24, 0.9) 42%,
      rgba(96, 50, 30, 0.78) 52%,
      rgba(140, 68, 38, 0.6) 62%,
      rgba(186, 102, 64, 0.4) 72%,
      rgba(224, 162, 124, 0.2) 82%,
      rgba(244, 220, 200, 0.07) 91%,
      rgba(251, 248, 243, 0) 100%
    );
    transform: translateY(calc(42vh * (1 - var(--sb, 0)))) scale(calc(0.2 + 2.8 * var(--sg, 0)));
    opacity: min(1, calc(var(--sb, 0) * 5));
    will-change: transform;
  }

  .sun-copy {
    position: relative;
    z-index: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .sun-eyebrow {
    font-size: 12.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 28px;
    transition: color 0.5s;
  }
  .fs-h {
    margin: 0 0 22px;
    font-size: clamp(40px, 6.4vw, 96px);
    line-height: 1.04;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  /* каждое слово: из размытого, прозрачного и чуть ниже в резкое на месте; --wp от 0 до 1 */
  .fs-h :global(.w) {
    display: inline-block;
    vertical-align: bottom;
    padding: 0 0.03em 0.08em;
  }
  .fs-h :global(.w i) {
    display: inline-block;
    font-style: normal;
    transition: color 0.5s;
    transform: translateY(calc(28% * (1 - var(--wp, 1))));
    filter: blur(calc(16px * (1 - var(--wp, 1))));
    opacity: var(--wp, 1);
  }
  .fs-h :global(.w.l2 i) {
    font-style: italic;
    color: var(--accent);
  }
  .sun-sub {
    font-family: var(--font-serif);
    font-size: clamp(18px, 1.8vw, 22px);
    color: var(--ink-muted);
    margin-bottom: 40px;
    transition: color 0.5s;
  }
  .sun-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }
  .sun-actions :global(.cta-group__main) {
    padding: 20px 38px;
    font-size: 17px;
    box-shadow: 0 26px 50px -24px rgba(31, 25, 21, 0.5);
    transition: background 0.4s, color 0.4s, box-shadow 0.4s, transform 0.18s;
  }
  .sun-actions :global(.cta-group__social) {
    width: 56px;
    height: 56px;
    transition: background 0.4s, border-color 0.4s, color 0.4s;
  }
  .sun-phone {
    font-size: 14px;
    color: var(--ink-muted);
    transition: color 0.5s;
  }

  /* перекраска по мере заливки (классы ставит motion.ts) */
  .sun-ft:global(.lit2) .fs-h :global(.l2 i) {
    color: var(--glow);
  }
  .sun-ft:global(.lit1) .fs-h :global(.w:not(.l2) i) {
    color: #ffffff;
  }
  .sun-ft:global(.lit1) .sun-eyebrow {
    color: rgba(255, 255, 255, 0.5);
  }
  .sun-ft:global(.lit1) .sun-sub {
    color: rgba(255, 255, 255, 0.72);
  }
  .sun-ft:global(.lit) .sun-actions :global(.cta-group__main) {
    background: linear-gradient(180deg, #d9784c, var(--accent));
    color: #ffffff;
    box-shadow: 0 26px 60px -20px rgba(217, 120, 76, 0.55);
  }
  .sun-ft:global(.lit) .sun-actions :global(.cta-group__social) {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.28);
    color: rgba(255, 255, 255, 0.9);
  }
  .sun-ft:global(.lit) .sun-actions :global(.cta-group__social:hover) {
    border-color: #ffffff;
    color: #ffffff;
  }
  .sun-ft:global(.lit) .sun-phone {
    color: rgba(255, 255, 255, 0.6);
  }
  .sun-ft:global(.lit) .sun-phone:hover {
    color: #ffffff;
  }

  @media (max-width: 760px) {
    .sun-scene {
      height: 200vh;
    }
  }
  @media (max-width: 480px) {
    .sun-actions :global(.cta-group) {
      justify-content: center;
    }
    .sun-actions :global(.cta-group__main) {
      padding: 18px 26px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .fs-h :global(.w i) {
      transform: none !important;
      filter: none !important;
    }
  }
</style>
