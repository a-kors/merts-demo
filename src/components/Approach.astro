---
import { approachQuote, approachPrinciples } from '../data/master';
---

<section class="approach">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <span class="section-eyebrow">Как я работаю</span>
      <h2>
        Четыре принципа, из&nbsp;которых складывается <em>переналадка
        мышления</em>&nbsp;— мой основной подход.
      </h2>
    </header>

    <div class="principles">
      {approachPrinciples.map((p, i) => (
        <article class="pr" data-reveal data-reveal-delay={Math.min(i * 100, 300)}>
          <span class="n">0{i + 1}</span>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </article>
      ))}
    </div>

    <figure class="quote" data-reveal>
      <span class="mark" aria-hidden="true">“</span>
      <blockquote>{approachQuote.text}</blockquote>
      <figcaption>— {approachQuote.source}</figcaption>
    </figure>
  </div>
</section>

<style>
  .approach {
    background: var(--bg-soft);
  }
  .section-head {
    max-width: 760px;
    margin-bottom: 48px;
  }
  .section-head h2 em {
    font-style: italic;
    color: var(--accent);
  }

  .principles {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 72px;
  }
  .pr {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px 24px;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 16px;
  }
  .n {
    font-family: var(--font-serif);
    font-size: 14px;
    letter-spacing: 0.1em;
    color: var(--accent);
  }
  .pr h3 {
    font-family: var(--font-serif);
    font-size: 20px;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--ink);
    margin: 0;
    font-weight: 400;
  }
  .pr p {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--ink-muted);
  }

  .quote {
    margin: 0 auto;
    max-width: 920px;
    text-align: left;
    position: relative;
    padding-left: 48px;
  }
  .mark {
    position: absolute;
    left: -8px;
    top: -36px;
    font-family: var(--font-serif);
    font-size: 180px;
    color: var(--accent);
    line-height: 1;
    opacity: 0.15;
    user-select: none;
  }
  blockquote {
    margin: 0 0 24px;
    font-family: var(--font-serif);
    font-size: clamp(22px, 2.6vw, 30px);
    line-height: 1.4;
    color: var(--ink);
    letter-spacing: -0.015em;
  }
  figcaption {
    font-size: 14px;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
    text-transform: uppercase;
  }

  @media (max-width: 1024px) {
    .principles {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .principles {
      grid-template-columns: 1fr;
    }
    .quote {
      padding-left: 28px;
    }
    .mark {
      left: -4px;
      top: -20px;
      font-size: 120px;
    }
  }
</style>
