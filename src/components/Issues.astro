---
import { issuesGroups, wellbeing } from '../data/master';
---

<section id="issues" class="soft-bg">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <span class="section-eyebrow">С чем работаю</span>
      <h2>
        Шесть направлений, в&nbsp;каждом — конкретные запросы, с&nbsp;которыми
        ко&nbsp;мне приходят.
      </h2>
      <p>
        Если вашей темы здесь нет, не&nbsp;значит, что я с&nbsp;ней
        не&nbsp;работаю. Напишите в&nbsp;двух абзацах — отвечу честно,
        подхожу&nbsp;ли я&nbsp;как специалист.
      </p>
    </header>

    <div class="grid">
      {issuesGroups.map((g, i) => (
        <article class="group" data-reveal data-reveal-delay={Math.min(i * 90, 360)}>
          <div class="group__head">
            <span class="kind">{g.kind}</span>
          </div>
          <h3>{g.title}</h3>
          <ul>
            {g.items.map((t) => <li>{t}</li>)}
          </ul>
        </article>
      ))}
    </div>

    <aside class="wellbeing" data-reveal>
      <div class="wb-head">
        <span class="section-eyebrow">когда «серьёзной проблемы нет»</span>
        <h3 class="serif wb-title">{wellbeing.title}</h3>
        <p class="muted">{wellbeing.pitch}</p>
      </div>
      <ul class="wb-list">
        {wellbeing.goals.map((g) => <li>— {g}</li>)}
      </ul>
    </aside>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-bottom: 72px;
  }
  .group {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 26px 24px 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .group:hover {
    transform: translateY(-2px);
    border-color: var(--accent-line);
    box-shadow: 0 20px 36px -24px rgba(31, 25, 21, 0.15);
  }
  .group__head {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .kind {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .group h3 {
    font-family: var(--font-serif);
    font-size: 20px;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--ink);
    margin: 0;
    font-weight: 400;
  }
  .group ul {
    list-style: none;
    padding: 0;
    margin: 4px 0 0;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .group li {
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--ink-muted);
    padding-left: 14px;
    position: relative;
  }
  .group li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 10px;
    width: 6px;
    height: 1px;
    background: var(--ink-soft);
  }

  .wellbeing {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 5vw, 72px);
    padding: clamp(32px, 5vw, 56px);
    background: var(--ink);
    color: #e9ecef;
    border-radius: var(--radius-lg);
  }
  .wb-title {
    color: #ffffff;
    font-size: clamp(24px, 2.8vw, 34px);
    line-height: 1.15;
    margin: 12px 0 18px;
  }
  .wellbeing .section-eyebrow {
    color: var(--accent-line);
    margin: 0;
  }
  .wellbeing .muted {
    color: rgba(255, 255, 255, 0.78);
    font-size: 16px;
    line-height: 1.6;
  }
  .wb-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
    font-size: 16px;
    color: rgba(255, 255, 255, 0.82);
    align-self: center;
  }

  @media (max-width: 1024px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .wellbeing {
      grid-template-columns: 1fr;
    }
  }
</style>
